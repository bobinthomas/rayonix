# Admin CMS Authentication (required for /admin)
# Use a strong password (>= 12 chars, upper + lower + digit + symbol)
ADMIN_PASSWORD=
# Optional: PBKDF2 or SHA-256 hex hash (preferred in production over plaintext ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=
# Secret used to sign HTTP-only session cookies (recommended in production)
ADMIN_SESSION_SECRET=

# On-demand cache revalidation secret for POST /api/revalidate
REVALIDATION_SECRET=
